# Leave LLM_PROVIDER=mock to run without an API key.
# Mock mode replays fixture extractions for bundled samples. It validates the
# pipeline, not Hebrew extraction quality. Use openai for that measurement.
LLM_PROVIDER=mock

# Pin the model so OpenAI regression is reproducible.
OPENAI_MODEL=gpt-4o

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Scanned PDFs with no text layer are rasterized and sent to the vision model.
